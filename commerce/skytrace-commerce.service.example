[Unit]
Description=SkyTrace Commerce Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/skytrace/commerce
ExecStart=/usr/bin/node /opt/skytrace/commerce/server.js
Restart=on-failure
RestartSec=3
User=skytrace
Group=skytrace
Environment=NODE_ENV=production
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/skytrace/commerce/data

[Install]
WantedBy=multi-user.target

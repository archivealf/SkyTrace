{
  "name": "SkyTrace",
  "short_name": "SkyTrace",
  "description": "Live aviation map, Nearby aircraft, Watchlists, Airport Desk and Replay+.",
  "id": "/app/",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#9eb8ee",
  "theme_color": "#080b11",
  "orientation": "any",
  "categories": ["travel", "navigation", "utilities"],
  "shortcuts": [
    { "name": "Nearby aircraft", "short_name": "Nearby", "url": "/app/?tab=nearby" },
    { "name": "Replay timeline", "short_name": "Replay", "url": "/app/?tab=replay" },
    { "name": "Airport Desk", "short_name": "Airports", "url": "/app/?tab=more" }
  ],
  "icons": [
    {
      "src": "/app/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}

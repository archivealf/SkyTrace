#!/usr/bin/env bash
set -euo pipefail

OWNER="archivealf"
REPO="SkyTrace"
APP_NAME="SkyTrace"
VERSION="v3.2.0"
INSTALL_DIR="$HOME/Applications"
APP_PATH="$INSTALL_DIR/$APP_NAME.app"
RAW_BASE="https://raw.githubusercontent.com/${OWNER}/${REPO}/main"

case "$(uname -m)" in
  arm64) ARCH="arm64" ;;
  x86_64) ARCH="x64" ;;
  *) echo "Unsupported Mac architecture: $(uname -m)"; exit 1 ;;
esac

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
trap 'echo; echo "SkyTrace install failed at line $LINENO."; exit 1' ERR

mkdir -p "$INSTALL_DIR" "$TMP/source/scripts" "$TMP/source/v3.2-bundle"

echo "Installing SkyTrace ${VERSION} Free Stack for macOS (${ARCH})..."

command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1 || {
  echo "Node.js 20.18+ and npm are required."
  exit 1
}

NODE_OK="$(node -e 'const [a,b]=process.versions.node.split(".").map(Number); process.stdout.write(String(a>20 || (a===20 && b>=18)))')"
if [[ "$NODE_OK" != "true" ]]; then
  echo "Node.js 20.18+ is required. Found: $(node --version)"
  exit 1
fi

echo "Downloading the verified SkyTrace V3.2 source bundle..."
for i in $(seq -w 0 17); do
  curl --fail --location --silent --show-error \
    "${RAW_BASE}/v3.2-bundle/chunk${i}.b64" \
    --output "$TMP/source/v3.2-bundle/chunk${i}.b64"
done

curl --fail --location --silent --show-error \
  "${RAW_BASE}/scripts/materialize-v3.2.sh" \
  --output "$TMP/source/scripts/materialize-v3.2.sh"

cd "$TMP/source"
bash scripts/materialize-v3.2.sh

# Use OurAirports' official direct-download mirror to avoid redirect/maintenance failures.
node - <<'NODE'
const fs = require('fs');
const p = 'scripts/update-aviation-data.mjs';
let s = fs.readFileSync(p, 'utf8');
s = s
  .replace('https://ourairports.com/data/airports.csv', 'https://davidmegginson.github.io/ourairports-data/airports.csv')
  .replace('https://ourairports.com/data/runways.csv', 'https://davidmegginson.github.io/ourairports-data/runways.csv')
  .replace('https://ourairports.com/data/airport-frequencies.csv', 'https://davidmegginson.github.io/ourairports-data/airport-frequencies.csv')
  .replace('https://ourairports.com/data/navaids.csv', 'https://davidmegginson.github.io/ourairports-data/navaids.csv');
fs.writeFileSync(p, s);
NODE

echo "Installing build dependencies..."
npm install --no-audit --no-fund

echo "Downloading free aviation reference data..."
npm run data

echo "Building the macOS icon..."
npm run icon:mac

echo "Checking source..."
npm run check

echo "Building SkyTrace.app for ${ARCH}..."
npm run package -- --arch="$ARCH"

FOUND_APP="$(find out -maxdepth 4 -name "${APP_NAME}.app" -type d -print -quit)"
[[ -n "$FOUND_APP" ]] || { echo "SkyTrace.app was not produced."; exit 1; }

if [[ -d "$APP_PATH" ]]; then
  echo "Updating existing installation..."
  rm -rf "$APP_PATH"
fi

ditto "$FOUND_APP" "$APP_PATH"

echo
echo "Installed successfully:"
echo "  $APP_PATH"
echo
echo "Opening SkyTrace..."
open "$APP_PATH"

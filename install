#!/usr/bin/env bash
set -euo pipefail

OWNER="archivealf"
REPO="SkyTrace"
APP_NAME="SkyTrace"
VERSION="v3.2.0"
INSTALL_DIR="$HOME/Applications"
APP_PATH="$INSTALL_DIR/$APP_NAME.app"

case "$(uname -m)" in
  arm64) ARCH="arm64" ;;
  x86_64) ARCH="x64" ;;
  *) echo "Unsupported Mac architecture: $(uname -m)"; exit 1 ;;
esac

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
mkdir -p "$INSTALL_DIR"

echo "Installing SkyTrace ${VERSION} Free Stack for macOS (${ARCH})..."

command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1 || {
  echo "Node.js 20.18+ and npm are required."
  exit 1
}

NODE_OK="$(node -e 'const [a,b]=process.versions.node.split(".").map(Number); process.stdout.write(String(a>20 || (a===20 && b>=18)))')"
if [[ "$NODE_OK" != "true" ]]; then
  echo "Node.js 20.18+ is required. Found: $(node --version)"
  exit 1
fi

SOURCE_DIR="$TMP/SkyTrace"

echo "Getting SkyTrace source..."
if command -v git >/dev/null 2>&1; then
  git clone --depth 1 --branch main "https://github.com/${OWNER}/${REPO}.git" "$SOURCE_DIR"
else
  echo "git is not available; using GitHub codeload instead..."
  SOURCE_ZIP="$TMP/source.zip"
  curl --fail --location --progress-bar \
    "https://codeload.github.com/${OWNER}/${REPO}/zip/refs/heads/main" \
    --output "$SOURCE_ZIP"
  mkdir -p "$TMP/extracted"
  ditto -x -k "$SOURCE_ZIP" "$TMP/extracted"
  EXTRACTED="$(find "$TMP/extracted" -maxdepth 1 -type d -name "${REPO}-*" -print -quit)"
  [[ -n "$EXTRACTED" ]] || { echo "Could not locate the downloaded SkyTrace source."; exit 1; }
  mv "$EXTRACTED" "$SOURCE_DIR"
fi

cd "$SOURCE_DIR"

echo "Preparing SkyTrace V3.2..."
bash scripts/materialize-v3.2.sh

echo "Installing build dependencies..."
npm install --no-audit --no-fund

echo "Downloading free aviation reference data..."
npm run data

echo "Building the macOS icon..."
npm run icon:mac

echo "Checking source..."
npm run check

echo "Building SkyTrace.app for ${ARCH}..."
npm run package -- --arch="$ARCH"

FOUND_APP="$(find out -maxdepth 4 -name "${APP_NAME}.app" -type d -print -quit)"
[[ -n "$FOUND_APP" ]] || { echo "SkyTrace.app was not produced."; exit 1; }

if [[ -d "$APP_PATH" ]]; then
  echo "Updating existing installation..."
  rm -rf "$APP_PATH"
fi

ditto "$FOUND_APP" "$APP_PATH"

echo
echo "Installed successfully:"
echo "  $APP_PATH"
echo
echo "Opening SkyTrace..."
open "$APP_PATH"

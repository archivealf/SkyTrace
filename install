#!/usr/bin/env bash
set -euo pipefail

RC_INSTALLER="https://raw.githubusercontent.com/archivealf/SkyTrace/v3.3-commerce/install-v3.4-rc1"
TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

echo "SkyTrace installer: preparing V3.4.0 RC1..."
curl --fail --location --silent --show-error "$RC_INSTALLER" --output "$TMP"

# The RC1 installer independently verifies architecture, source identity,
# commercial hardening, runtime audit, bundle ID and final 3.4.0 app version.
bash "$TMP"

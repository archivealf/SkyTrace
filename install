#!/usr/bin/env bash
set -euo pipefail

RC_INSTALLER="https://raw.githubusercontent.com/archivealf/SkyTrace/v3.3-commerce/install"
TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

echo "SkyTrace installer: switching to V3.3.1 Performance RC..."
curl --fail --location --silent --show-error "$RC_INSTALLER" --output "$TMP"

# The RC installer independently verifies the source branch, commercial hardening,
# performance markers and final 3.3.1 app version before replacing SkyTrace.app.
bash "$TMP"

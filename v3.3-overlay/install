#!/usr/bin/env bash
set -euo pipefail

RC_INSTALLER="https://raw.githubusercontent.com/archivealf/SkyTrace/v3.3-commerce/install-v3.4-rc1"
TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

if ! curl --fail --location --silent --show-error "$RC_INSTALLER" --output "$TMP"; then
  printf 'Could not download the SkyTrace installer. Check your internet connection and try again.\n' >&2
  exit 1
fi

bash "$TMP"
